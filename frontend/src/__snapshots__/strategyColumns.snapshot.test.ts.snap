  {
    "abbrev": true,
    "heatmap": true,
    "id": "net_apr_pct_tenths",
    "info": "APR from one-contract net capital: (net premium / (100 × (current − bid))) × 365 / DTE.",
    "label": "APR (net)",
  },
  {
    "abbrev": false,
    "heatmap": false,
    "id": "breakeven_cents",
    "info": "Breakeven stock price: current − call bid. Contracts does not scale this.",
    "label": "Breakeven",
  },
  {
    "abbrev": true,
    "heatmap": true,
    "id": "breakeven_change_pct_tenths",
    "info": "Percent the stock must rise from the current price to the strike before assignment. Negative when the stock is already above the strike. Contracts does not scale this.",
    "label": "% to assignment",
  },
]
`;

